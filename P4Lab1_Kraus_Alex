# turtle_bench.py - a practice program from the Turtle Loop Bench
# Run it in IDLE: press F5. Close the window to stop.

import turtle

# ---- THE KNOBS: change these numbers, then press F5 again ----
COUNT = 120        # how many times the loop runs
LENGTH = 65        # length of the first line, in steps
TURN = 140         # degrees to turn left after each line
GROW = 1           # steps added to the length after each line
COLORS = ["#9D0208", "#DC2F02", "#F48C06", "#FFBA08"]

screen = turtle.Screen()
screen.bgcolor("white")
t = turtle.Turtle()
t.speed(0)         # 0 = fastest

# lines drawn = COUNT = 120
t.penup()
t.goto(200, 180)
t.pendown()
length = LENGTH
for i in range(COUNT):                     # one pass = one line
    t.pencolor(COLORS[i % len(COLORS)])    # pick the next color
    t.forward(length)
    t.left(TURN)
    length = length + GROW

t.hideturtle()
turtle.done()      # keeps the window open


# End - keep window open
turtle.done()